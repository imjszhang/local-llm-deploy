{
  "example-chat": {
    "full_model_name": "示例对话模型（请改名并改 repo_id）",
    "repo_id": "unsloth/Your-Model-GGUF",
    "download_source": "modelscope",
    "default_quant": "Q4_K_M",
    "alias": "unsloth/Your-Model",
    "default_port": 8001,
    "quants": {
      "Q4_K_M": {
        "pattern": "*.gguf",
        "size_gb": 10
      }
    },
    "params": {
      "temp": 0.8,
      "top_p": 0.95,
      "ctx_size": 8192,
      "n_predict": 4096,
      "repeat_penalty": 1.0,
      "max_concurrent": 1,
      "kv_budget_ratio": 0.9,
      "extra_args": []
    }
  },
  "qwen3.8-27b-aggressive": {
    "full_model_name": "Qwen3.8-27B Uncensored HauhauCS Aggressive (Q5_K_P GGUF)",
    "repo_id": "HauhauCS/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF",
    "repo_name": "HauhauCS-Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF",
    "download_source": "huggingface",
    "default_quant": "Q5_K_P",
    "alias": "qwen3.8-27b-aggressive",
    "default_port": 8002,
    "quants": {
      "Q5_K_P": {
        "pattern": "*Q5_K_P.gguf",
        "size_gb": 20.22
      }
    },
    "params": {
      "temp": 0.7,
      "top_p": 0.8,
      "ctx_size": 8192,
      "n_predict": 4096,
      "repeat_penalty": 1.0,
      "max_concurrent": 1,
      "kv_budget_ratio": 0.9,
      "extra_args": [
        "--jinja",
        "--top-k",
        "20",
        "--presence-penalty",
        "1.5",
        "--fit",
        "off",
        "--n-gpu-layers",
        "999",
        "--device",
        "MTL0",
        "--flash-attn",
        "on",
        "--reasoning",
        "off",
        "--no-reasoning-preserve",
        "--chat-template-kwargs",
        "{\"enable_thinking\":false}"
      ]
    }
  },
  "qwen3.8:27b-mlx": {
    "type": "ollama",
    "full_model_name": "Qwen3.8 27B (Ollama MLX)",
    "ollama_model": "qwen3.8:27b-mlx",
    "alias": "qwen3.8:27b-mlx",
    "default_port": 11434,
    "startup_hint": "由 Ollama 提供；安装: ollama pull qwen3.8:27b-mlx",
    "params": {
      "ctx_size": 262144,
      "n_predict": 32768,
      "max_concurrent": 1,
      "kv_budget_ratio": 0.9
    }
  },
  "jina-embed": {
    "type": "embedding",
    "download_source": "modelscope",
    "repo_id": "jinaai/jina-embeddings-v5-text-small",
    "repo_name": "jinaai-jina-embeddings-v5-text-small",
    "alias": "jina-embeddings-v5-text-small",
    "default_port": 8004,
    "params": {
      "dimensions": 1024,
      "default_task": "text-matching"
    }
  },
  "jina-rerank-mlx": {
    "type": "rerank",
    "repo_id": "jinaai/jina-reranker-v3-mlx",
    "repo_name": "jinaai-jina-reranker-v3-mlx",
    "download_source": "huggingface",
    "alias": "jina-reranker-v3",
    "default_port": 8006,
    "params": {
      "max_documents": 64
    }
  },
  "whisper-large-v3": {
    "type": "asr",
    "full_model_name": "Whisper Large V3 (MLX)",
    "download_source": "huggingface",
    "repo_id": "mlx-community/whisper-large-v3-mlx",
    "repo_name": "mlx-community-whisper-large-v3-mlx",
    "alias": "whisper-large-v3",
    "default_port": 8007,
    "download_allow_patterns": ["*.json", "*.npz", "*.safetensors", "*.txt", "tokenizer*"],
    "params": {
      "language": "zh",
      "task": "transcribe",
      "response_format": "json"
    }
  },
  "ds4": {
    "type": "external",
    "full_model_name": "DeepSeek V4 Flash (ds4-server / antirez)",
    "repo_id": "antirez/deepseek-v4-flash",
    "alias": "antirez/deepseek-v4-flash",
    "backend_model": "deepseek-v4-flash",
    "default_port": 8005,
    "external_backend": true,
    "startup_hint": "./ds4.sh start  （launchd 常驻，端口 8005，batched-session 4；请设置 DS4_ROOT 指向本地 ds4 仓库）",
    "params": {
      "ctx_size": 100000,
      "n_predict": 393216,
      "max_concurrent": 1,
      "kv_budget_ratio": 0.85
    }
  }
}
